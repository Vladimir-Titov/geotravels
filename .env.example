GEOTRAVELS_APP_NAME=geotravels
GEOTRAVELS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54441/postgres
GEOTRAVELS_JWT_SECRET=change-me-in-prod
GEOTRAVELS_JWT_ALGORITHM=HS256
GEOTRAVELS_ACCESS_TOKEN_TTL_MINUTES=15
GEOTRAVELS_REFRESH_TOKEN_TTL_DAYS=30
GEOTRAVELS_COUNTRIES_GEOJSON_PATH=data/countries.geojson
GEOTRAVELS_CORS_ALLOWED_ORIGINS="*"
GEOTRAVELS_DB_POOL_MIN_SIZE=5
GEOTRAVELS_DB_POOL_MAX_SIZE=20
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

#LOG
GEOTRAVELS_LOG_LEVEL=DEBUG
GEOTRAVELS_SENTRY_DSN=
GEOTRAVELS_SENTRY_ENABLE=false
GEOTRAVELS_SENTRY_TRACES_SAMPLE_RATE=1.0
GEOTRAVELS_SENTRY_SEND_DEFAULT_PII=false
GEOTRAVELS_SENTRY_ATTACH_STACKTRACE=false
